---
const readingDimensions = [
  {
    number: '01',
    title: '閱他人',
    question: '在關鍵時刻，你做了什麼選擇？又放棄了什麼？',
    detail: '從真實生命故事出發，理解每一條路背後的猶豫、代價與承擔。',
  },
  {
    number: '02',
    title: '閱自己',
    question: '我追求的是安全感、認同感，還是真正想走的方向？',
    detail: '在文本、書寫與對話裡，練習辨認自己的價值、慣性與恐懼。',
  },
  {
    number: '03',
    title: '閱時代',
    question: '個人的選擇，如何與我們身處的世界相連？',
    detail: '把科技、產業與社會放回問題裡，理解人生從來不是在真空中發生。',
  },
];

const principles = [
  '問題先於答案',
  '人生是意義題，不是工具題',
  '人必須放入世界中理解',
];

const waysOfMeeting = [
  {
    title: '一起閱讀',
    detail: '從經典文本、人物生命故事與當代議題出發，把問題讀得更深一點。',
  },
  {
    title: '一起對話',
    detail: '透過引導式書寫、小組討論與工作坊，練習說出尚未成形的想法，也練習傾聽。',
  },
  {
    title: '一起遇見',
    detail: '在閱人沙龍與跨世代交流裡，理解不同人生選擇背後的代價、轉折與承擔。',
  },
];

const participationQuestions = [
  {
    question: '誰可以參加？',
    answer: '如果你關心人生選擇、他人的生命經驗與當代議題，歡迎先認識我們。各場活動的參加對象與報名條件，請依活動公告確認。',
  },
  {
    question: '需要先讀完書或準備資料嗎？',
    answer: '各場活動的閱讀材料與準備方式，請以當次公告為準；有疑問可先在 LINE 社群詢問。',
  },
  {
    question: '加入社群就是完成活動報名嗎？',
    answer: 'LINE 社群用於接收活動資訊與交流；個別活動是否需要另外報名，請依該場公告辦理。',
  },
  {
    question: '為什麼加入時要填寫理由？',
    answer: '為避免機器人加入，請簡短分享你對社群的興趣，或想一起討論的問題。',
  },
];

const lineInviteUrl = 'https://line.me/ti/g2/o4xP4WGxO__9CgVgP-ReAbyjnv0yBUfdZY-1Dw?utm_source=invitation&utm_medium=link_copy&utm_campaign=default';
const siteUrl = 'https://xbridge.maxosoft.com';
const pageTitle = 'X-Bridge Yueren Club｜橫渠閱人社｜閱人，亦閱己';
const pageDescription = '橫渠閱人社：一個練習看懂人、看懂自己、看懂人生選擇的社群。';
const socialImageUrl = `${siteUrl}/social-card.png?v=20260910`;
const socialImageDescription = '橫渠閱人社 X-Bridge Yueren Club：閱人，亦閱己。發起於成功大學，社團申請籌備中。';
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageDescription} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="X-Bridge Yueren Club 橫渠閱人社首頁">
        <img class="brand-mark" src="/brand/logo-primary.png" alt="" width="280" height="268" />
        <span class="brand-copy">
          <span>橫渠閱人社</span>
          <small>X-Bridge Yueren Club</small>
        </span>
      </a>
      <nav aria-label="主要導覽">
        <a href="#about">關於我們</a>
        <a href="#reading">怎麼閱讀</a>
        <a href="#approach">怎麼相遇</a>
        <a href="#join">加入對話</a>
      </nav>
    </header>

    <main id="top">
      <section class="intro" aria-labelledby="intro-title">
        <p class="eyebrow">X-Bridge Yueren Club · 發起於成功大學 · 2026</p>
        <h1 id="intro-title"><span>閱人，</span><span>亦閱己。</span></h1>
        <p class="lead">一個練習看懂人、看懂自己、看懂人生選擇的社群。</p>
        <div class="intro-actions">
          <a class="button" href="#about">認識橫渠</a>
          <a class="button button-outline" href={lineInviteUrl} target="_blank" rel="noopener noreferrer">加入 LINE 社群</a>
        </div>
        <p class="quote">「為天地立心，為生民立命，為往聖繼絕學，為萬世開太平。」<span>張載．橫渠四句</span></p>
      </section>

      <section id="about" class="section statement" aria-labelledby="about-title">
        <p class="section-label">為什麼有橫渠</p>
        <div class="section-content">
          <h2 id="about-title">在急著回答之前，<br />先讓真正的問題被好好提出。</h2>
          <div class="statement-copy">
            <p>由成大學生發起的橫渠閱人社，想保留一個能承受困惑、允許答案暫緩的公共空間。在追求效率、成果與快速定位的校園裡，我們常被催促著回答「要成為什麼樣的人」。</p>
            <p>我們不替你規劃人生，也不急著提供方向；我們一起問：什麼樣的人生，值得被認真地活？</p>
          </div>
        </div>
      </section>

      <section id="reading" class="section readings" aria-labelledby="reading-title">
        <div class="section-heading">
          <p class="section-label">三種閱讀</p>
          <h2 id="reading-title">理解一個人，<br />也是理解世界與自己。</h2>
          <div class="reading-intro">
            <blockquote class="reading-quote"><p><span>「見自己，</span><span>見天地，</span><span>見眾生。」</span></p></blockquote>
            <p>認識自己，認識朋友，看懂世界。</p>
            <p class="reading-tagline">學而時習之，不亦「閱」乎。</p>
          </div>
        </div>
        <div class="reading-grid">
          {readingDimensions.map((item) => (
            <article class="reading-card">
              <p class="number">{item.number}</p>
              <h3>{item.title}</h3>
              <p class="question">{item.question}</p>
              <p>{item.detail}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="approach" class="section encounters" aria-labelledby="approach-title">
        <div class="section-heading">
          <p class="section-label">我們怎麼相遇</p>
          <h2 id="approach-title">從閱讀開始，<br />在對話裡慢慢靠近問題。</h2>
        </div>
        <div class="encounter-grid">
          {waysOfMeeting.map((item, index) => (
            <article class="encounter-item">
              <p class="number">{String(index + 1).padStart(2, '0')}</p>
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="participate" class="section participation" aria-labelledby="participate-title">
        <p class="section-label">參與之前</p>
        <div class="section-content">
          <h2 id="participate-title">參與前想知道的事</h2>
          <div class="activity-note">
            <p class="activity-status">近期活動資訊籌備中</p>
            <p>活動時間、頻率與地點確認後，將於 LINE 社群公告。可以先加入社群，接收活動與報名資訊。</p>
            <a class="text-link" href="#join">查看加入方式</a>
          </div>
          <div class="faq-list">
            {participationQuestions.map((item) => (
              <details class="faq-item">
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="section principles" aria-labelledby="principles-title">
        <p class="section-label">我們守住的事</p>
        <div class="section-content">
          <h2 id="principles-title">慢一點，難一點，<br />但不把人生縮減成選項比較。</h2>
          <ol>
            {principles.map((principle, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{principle}</li>)}
          </ol>
        </div>
      </section>

      <section id="join" class="section join" aria-labelledby="join-title">
        <div class="join-copy">
          <p class="section-label">成為同行者</p>
          <h2 id="join-title">有些問題，<br />不必一個人急著回答。</h2>
          <p>加入 LINE 社群，接收活動資訊，也和願意認真提問的人一起對話。</p>
          <p class="join-note">為避免機器人加入，請簡短填寫加入理由，分享你對社群的興趣。</p>
          <p class="join-status">發起於成功大學 · 社團申請籌備中</p>
          <a class="button button-light" href={lineInviteUrl} target="_blank" rel="noopener noreferrer">前往 LINE 社群</a>
        </div>
        <div class="qr-panel">
          <img src="/line-community-qr.png" alt="加入成大橫渠閱人社 LINE 社群的 QR Code" width="720" height="720" />
          <p>掃描加入社群</p>
        </div>
      </section>
    </main>

    <footer>
      <span>橫渠閱人社</span>
      <span>X-Bridge Yueren Club · 發起於成功大學</span>
    </footer>
  </body>
</html>

<style>
  :root {
    color: #243746;
    background: #f3efe6;
    font-family: "Noto Serif TC", "Songti TC", "PMingLiU", serif;
    font-synthesis: none;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; line-height: 1.75; }
  a { color: inherit; text-decoration: none; }
  a:focus-visible, summary:focus-visible { outline: 3px solid #a65d45; outline-offset: 4px; }

  .site-header {
    align-items: center;
    display: flex;
    justify-content: space-between;
    margin: 0 auto;
    max-width: 1280px;
    padding: 26px 48px;
  }

  .brand { align-items: center; display: flex; font-size: 1.1rem; font-weight: 700; gap: 10px; line-height: 1.35; }
  .brand-mark { flex: 0 0 auto; height: 40px; width: auto; }
  .brand-copy { display: flex; flex-direction: column; }
  .brand small { color: #52685a; font-family: system-ui, sans-serif; font-size: .65rem; font-weight: 600; margin-top: 3px; }
  nav { display: flex; flex-wrap: wrap; font-family: system-ui, sans-serif; font-size: .9rem; gap: 14px; }
  nav a { align-items: center; display: flex; justify-content: center; min-height: 44px; padding: 8px 6px; }
  nav a:hover { color: #a65d45; }

  .intro {
    border-bottom: 1px solid #d8d5cc;
    margin: 0 auto;
    max-width: 1280px;
    padding: 88px 48px 48px;
  }

  .eyebrow, .section-label, .number {
    color: #a65d45;
    font-family: system-ui, sans-serif;
    font-size: .8rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  h1, h2, h3, p { margin-top: 0; }
  h1 { font-size: 7rem; font-weight: 500; line-height: 1.15; margin: 26px 0 20px; }
  h1 span, .reading-quote span { display: inline-block; }
  h2 { font-size: 3rem; font-weight: 500; line-height: 1.35; margin-bottom: 34px; text-wrap: pretty; }
  .lead { font-size: 1.375rem; max-width: 680px; }
  .intro-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .button { background: #243746; border: 1px solid transparent; color: #fff; display: inline-flex; align-items: center; justify-content: center; font-family: system-ui, sans-serif; font-size: .95rem; min-height: 48px; padding: 11px 22px; }
  .button:hover { background: #a65d45; color: #fff; }
  .button-outline { background: transparent; border-color: #243746; color: #243746; }
  .button-outline:hover { border-color: #a65d45; }
  .quote { color: #52685a; font-size: .95rem; margin: 64px 0 0 auto; max-width: 420px; }
  .quote span { display: block; font-family: system-ui, sans-serif; font-size: .8rem; margin-top: 8px; }

  .section { margin: 0 auto; max-width: 1280px; padding: 96px 48px; }
  .statement, .principles, .participation { align-items: start; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.5fr); gap: 48px; }
  .section-content { min-width: 0; }
  .statement-copy { font-size: 1.12rem; max-width: 620px; }
  .statement-copy p:last-child { margin-bottom: 0; }
  .statement-copy p + p { margin-top: 28px; }
  .readings { background: #d8d5cc; max-width: none; padding-left: max(48px, calc((100vw - 1184px) / 2)); padding-right: max(48px, calc((100vw - 1184px) / 2)); }
  .section-heading { margin-bottom: 48px; }
  .reading-intro { color: #52685a; font-size: 1.05rem; line-height: 1.85; margin-top: 28px; max-width: 680px; }
  .reading-intro > p { margin-bottom: 8px; }
  .reading-quote { border-left: 3px solid #a65d45; color: #243746; font-size: 1.65rem; line-height: 1.65; margin: 0 0 20px; padding-left: 20px; }
  .reading-quote p { margin-bottom: 0; }
  .reading-tagline { color: #243746; }
  .reading-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; }
  .reading-card { border-left: 1px solid #aeb0a8; padding: 0 32px; }
  .reading-card:first-child { border-left: 0; padding-left: 0; }
  .reading-card h3 { font-size: 2rem; font-weight: 500; margin: 28px 0 16px; }
  .question { font-size: 1.12rem; line-height: 1.65; min-height: 100px; }
  .encounters { border-bottom: 1px solid #d8d5cc; }
  .encounter-grid { border-top: 1px solid #d8d5cc; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .encounter-item { border-left: 1px solid #d8d5cc; padding: 30px 32px 6px; }
  .encounter-item:first-child { border-left: 0; padding-left: 0; }
  .encounter-item h3 { font-size: 1.75rem; font-weight: 500; margin: 25px 0 14px; }
  .participation { border-bottom: 1px solid #d8d5cc; }
  .activity-note { font-size: 1.05rem; margin-bottom: 32px; max-width: 620px; }
  .activity-status { color: #52685a; font-family: system-ui, sans-serif; font-size: .9rem; font-weight: 600; margin-bottom: 12px; }
  .text-link { align-items: center; display: inline-flex; min-height: 44px; text-decoration: underline; text-underline-offset: 5px; }
  .text-link:hover { color: #a65d45; }
  .faq-list { border-top: 1px solid #d8d5cc; }
  .faq-item { border-bottom: 1px solid #d8d5cc; }
  .faq-item summary { cursor: pointer; font-size: 1.1rem; min-height: 56px; padding: 16px 0; }
  .faq-item summary::marker { color: #52685a; }
  .faq-item p { color: #52685a; margin: 0 0 24px; max-width: 620px; }
  .principles ol { border-top: 1px solid #d8d5cc; list-style: none; margin: 8px 0 0; padding: 0; }
  .principles li { align-items: baseline; border-bottom: 1px solid #d8d5cc; display: flex; font-size: 1.18rem; gap: 24px; padding: 17px 0; }
  .principles li span { color: #a65d45; flex: 0 0 auto; font-family: system-ui, sans-serif; font-size: .8rem; }
  .join { align-items: center; background: #243746; color: #f3efe6; display: grid; gap: 70px; grid-template-columns: minmax(0, 1fr) 220px; max-width: none; padding-left: max(48px, calc((100vw - 1184px) / 2)); padding-right: max(48px, calc((100vw - 1184px) / 2)); }
  .join .section-label { color: #d9a090; }
  .join-copy > p:not(.section-label) { font-size: 1.1rem; max-width: 530px; }
  .join-note { color: #d8d5cc; font-size: .95rem !important; margin-bottom: 8px; }
  .join-status { color: #d9a090; font-family: system-ui, sans-serif; font-size: .85rem !important; }
  .button-light { background: #f3efe6; color: #243746; }
  .qr-panel { background: #f3efe6; color: #243746; padding: 14px; text-align: center; }
  .qr-panel img { display: block; height: auto; max-width: 190px; width: 100%; }
  .qr-panel p { font-family: system-ui, sans-serif; font-size: .85rem; margin: 8px 0 0; }
  footer { background: #243746; border-top: 1px solid #52685a; color: #d8d5cc; display: flex; font-family: system-ui, sans-serif; font-size: .75rem; justify-content: space-between; padding: 25px max(48px, calc((100vw - 1184px) / 2)); }

  @media (max-width: 1000px) {
    h1 { font-size: 5rem; }
    h2 { font-size: 2.5rem; }
    .statement, .principles, .participation { grid-template-columns: 1fr; gap: 24px; }
  }

  @media (max-width: 720px) {
    .site-header { align-items: flex-start; flex-direction: column; gap: 12px; padding: 20px 24px; }
    nav { display: grid; font-size: .875rem; gap: 4px; grid-template-columns: repeat(4, minmax(0, 1fr)); width: 100%; }
    nav a { padding: 8px 0; }
    h1 { font-size: 3.25rem; }
    h1 span { display: block; }
    h2 { font-size: 2rem; }
    .lead { font-size: 1.15rem; }
    .intro { padding: 48px 24px 36px; }
    .intro-actions { gap: 12px; }
    .intro-actions .button { padding: 11px 16px; }
    .quote { margin-top: 48px; }
    .section { padding: 64px 24px; }
    .statement > .section-label, .principles > .section-label, .participation > .section-label { margin-bottom: 0; }
    .reading-quote { font-size: 1.4rem; padding-left: 14px; }
    .readings, .join { padding-left: 24px; padding-right: 24px; }
    .join { display: block; }
    .qr-panel { margin-top: 40px; max-width: 190px; }
    .reading-grid, .encounter-grid { display: block; }
    .reading-card, .reading-card:first-child { border-left: 0; border-top: 1px solid #aeb0a8; padding: 28px 0; }
    .reading-card:first-child { border-top: 0; padding-top: 0; }
    .encounter-item, .encounter-item:first-child { border-left: 0; border-top: 1px solid #d8d5cc; padding: 28px 0; }
    .encounter-item:first-child { border-top: 0; padding-top: 0; }
    .question { min-height: 0; }
    footer { flex-wrap: wrap; gap: 12px; padding: 22px 24px; }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
</style>
