---
const curriculum = [
  { week: '01', title: 'AI 實習生報到', concept: '任務判斷、SOP 拆解、Context 與 Memory', outcome: '寫出一份自己的任務 SOP' },
  { week: '02', title: '接上你的生活', concept: 'MCP 與 Connector：連接信箱、行事曆等工具', outcome: '產出每日待辦與待回信件摘要' },
  { week: '03', title: '寫一本 AI 手冊', concept: 'Agent Skill、排程、權限與 Prompt Injection', outcome: '建立可重複使用的 Skill，練習自動執行' },
  { week: '04', title: '拆開 Agent 看原理', concept: '聊天機器人與 Agent 的差別、LLM 特性與五種工作流', outcome: '為自己的任務選擇一種工作流' },
  { week: '05', title: '工作流實作（一）', concept: 'Prompt Chaining、Routing、Parallelization', outcome: '從三種工作流中選一種完成實作' },
  { week: '06', title: '工作流實作（二）', concept: 'Evaluator-Optimizer、Orchestrator-Workers', outcome: '練習檢核會議紀錄或製作附出處的研究報告' },
  { week: '07', title: '從一支到一隊', concept: '多個 Skill 分工、團隊公約與時間／額度成本', outcome: '完成期末專題初版，記錄使用成本' },
  { week: '08', title: '成果發表', concept: '展示、互評、分享與反思', outcome: '發表能解決自己真實問題的 Agent' },
];

const resources = [
  {
    title: '橫渠 AI 共作計畫｜8 週課綱',
    detail: '養一位 AI 實習生：課程目標、課前準備與完整 8 週安排',
    meta: 'PDF · 5 頁 · 265 KB',
    href: '/downloads/ai-agent-camp-syllabus-20261020.pdf?v=20261101',
  },
  {
    title: '橫渠 AI 共作計畫｜第 1–2 週講義',
    detail: 'AI 實習生報到・接上你的生活：從任務 SOP 到信箱、行事曆串接',
    meta: 'PDF · 22 頁 · 2.9 MB',
    href: '/downloads/ai-agent-camp-weeks-1-2.pdf?v=20261031',
  },
  {
    title: '橫渠 AI 共作計畫｜第 3 週講義',
    detail: '寫一本 AI 手冊：把指令變成 Skill，讓 AI 自己按時上工',
    meta: 'PDF · 15 頁 · 2.1 MB',
    href: '/downloads/hengqu-ai-week-3.pdf',
  },
  {
    title: '橫渠 AI 共作計畫｜第 4 週講義',
    detail: '拆開 Agent 看原理：理解運作方式，為自己的任務選擇工作流',
    meta: 'PDF · 13 頁 · 1.9 MB',
    href: '/downloads/hengqu-ai-week-4.pdf',
  },
  {
    title: '橫渠 AI 共作計畫｜第 5 週講義',
    detail: '工作流實作（一）：把工作切開，練習分流、接力與同時執行',
    meta: 'PDF · 13 頁 · 1.7 MB',
    href: '/downloads/hengqu-ai-week-5.pdf',
  },
  {
    title: '橫渠 AI 共作計畫｜第 6 週講義',
    detail: '工作流實作（二）：讓 AI 自己把關品質，練習做了再審與主管分派',
    meta: 'PDF · 13 頁 · 1.8 MB',
    href: '/downloads/hengqu-ai-week-6.pdf',
  },
];

const siteUrl = 'https://xbridge.maxosoft.com';
const stages = [
  { number: '01', weeks: '第 1–3 週', title: '讓實習生上工', description: '把一件日常任務，變成 AI 能照著做的工作。', items: curriculum.slice(0, 3) },
  { number: '02', weeks: '第 4–6 週', title: '理解與改善工作流', description: '看懂它怎麼做，再練習分工、查核與修正。', items: curriculum.slice(3, 6) },
  { number: '03', weeks: '第 7–8 週', title: '協作與發表', description: '組合自己的做法，帶著真實專題與同學交流。', items: curriculum.slice(6) },
];
const examples = [
  { number: '01', title: '作業截止日，不再散落各處', input: '自己的課表與作業公告', process: '依照任務 SOP 整理日期與待辦', output: '一份可逐項核對的本週作業清單', label: '本週作業', lines: ['整理閱讀報告截止日', '列出小組分工與待辦', '標記需要再次確認的日期'] },
  { number: '02', title: '開始一天前，先看清楚事情', input: '授權串接的信箱與行事曆', process: '彙整行程，辨認需要回覆的信件', output: '每日行程與待回信摘要', label: '今日摘要', lines: ['今天有哪些行程？', '哪些信件需要我回覆？', '先擬草稿，由我確認再送出'] },
  { number: '03', title: '研究有脈絡，說法有出處', input: '一個研究題目與參考資料', process: '分工整理，再檢查說法與來源', output: '附來源、可追查的研究筆記', label: '研究筆記', lines: ['整理問題與主要發現', '為說法附上可查閱來源', '保留待確認與不同觀點'] },
];
const changes = [
  { before: '每次開新對話，重新解釋一次', after: '留下任務 SOP 與背景，練習重複使用', skill: '把需求說清楚' },
  { before: '收到一份答案，不確定能不能用', after: '訂出檢查標準，核對來源、數字與遺漏', skill: '讓成果可檢查' },
  { before: '事情一多，只能一件接著一件問', after: '理解任務差異，選擇分流、接力或協作', skill: '安排工作的順序' },
];
const faqs = [
  { question: '沒有程式背景，也跟得上嗎？', answer: '課程面向不限科系、沒有程式背景的成功大學學生。從自己的小任務開始，透過操作與實作理解概念，逐步完成專題。' },
  { question: '每週需要準備多少時間？', answer: '每週上課 1 小時，課後約 1–2 小時實作。作業以自己的課表、信件或文件為素材，練習把課堂做法放回日常。' },
  { question: '需要哪一種 AI 工具？有額外費用嗎？', answer: '示範以 Claude 為主，ChatGPT 使用者可參考課綱的功能對照。部分功能可能需要付費方案；工具訂閱費與課程費不同，功能、價格與方案限制請以各工具最新官方說明為準。課程費用與報名條件請依活動公告確認。' },
  { question: '加入 LINE 社群，就是完成報名嗎？', answer: '不是。LINE 社群用來接收活動資訊與交流；實際上課日期、時間、地點、名額及報名方式，請依活動公告確認。加入社群不等於完成活動報名。' },
];
const canonicalUrl = `${siteUrl}/resources/`;
const pageTitle = '橫渠 AI 共作計畫｜養一位 AI 實習生｜8 週 AI Agent 實作課';
const pageDescription = '橫渠 AI 共作計畫，由成大橫渠閱人社主辦。養一位 AI 實習生，從你的第一件真實任務開始。零程式背景，8 週 AI Agent 實作課，學習 SOP、Connector、Skill 與工作流；查看課程大綱及下載講義。';
const socialImageUrl = `${siteUrl}/social-card.png?v=20261004`;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content="成大橫渠閱人社" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="成大橫渠閱人社：閱人，亦閱己。學生社團申請籌備中。" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="成大橫渠閱人社：閱人，亦閱己。學生社團申請籌備中。" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="X-Bridge Yueren Club 成大橫渠閱人社首頁">
        <img class="brand-mark" src="/brand/logo-primary.png" alt="" width="280" height="268" />
        <span class="brand-copy">
          <span>成大橫渠閱人社</span>
          <small>X-Bridge Yueren Club</small>
        </span>
      </a>
      <nav class="header-links" aria-label="主要導覽"><a href="/">回到首頁</a><a class="header-download" href="#downloads">下載講義 <span aria-hidden="true">↓</span></a></nav>
    </header>

    <main>
      <section class="intro page-width" aria-labelledby="resources-title">
        <div class="intro-copy">
        <p class="eyebrow">橫渠 AI 共作計畫</p>
        <h1 id="resources-title"><span>養一位</span> <span>AI 實習生</span></h1>
        <p class="lead">從你的第一件真實任務開始。</p>
        <p class="intro-description">把課表、信件與讀不完的資料帶來，<br class="desktop-break" />用 8 週一起練習，讓 AI 開始接得住工作。</p>
        <p class="course-tagline">零程式背景 <span aria-hidden="true">／</span> 8 週 AI Agent 實作課</p>
        <div class="intro-actions"><a class="button" href="#examples">看看能做出什麼 <span aria-hidden="true">↘</span></a><a class="text-link" href="#downloads">下載課綱與講義</a></div>
        <p class="course-meta">主辦：橫渠閱人社<br />發起於成功大學 · 學生社團申請籌備中</p>
        </div>
        <aside class="task-book" aria-label="AI 實習生的任務手冊，成果示意">
          <div class="book-header"><span>我的 AI 實習生</span><span class="sample-tag">成果示意</span></div>
          <div class="book-body"><p class="book-kicker">第一件工作</p><p class="book-title">幫我整理<br />這一週的待辦。</p><p class="book-description">讀懂任務 → 照步驟做 → 留給我確認</p>
          <ul class="task-checklist"><li><span aria-hidden="true">✓</span> 讀取我準備的課表與公告</li><li><span aria-hidden="true">✓</span> 整理截止日、分工與待辦</li><li><span aria-hidden="true">○</span> 不確定的地方，先標記出來</li></ul>
          <div class="book-note"><span>我的工作</span><p>把問題想清楚，<br />也為最後的選擇負責。</p></div></div>
          <div class="book-footer"><span>從一份 SOP，到一個可重複使用的做法</span><span aria-hidden="true">↗</span></div>
        </aside>
      </section>

      <nav class="course-nav page-width" aria-label="課程頁導覽"><a href="#examples">實作成果</a><a href="#curriculum">8 週路線</a><a href="#overview">參與方式</a><a href="#faq">常見問題</a><a href="#downloads">講義下載</a></nav>

      <section id="examples" class="course-section page-width" aria-labelledby="examples-title">
        <div class="section-heading"><div><p class="eyebrow">01 ／ 從生活裡的小事開始</p><h2 id="examples-title">帶一件真實的事來，<br />練習把它做好。</h2></div><p>選課、報告、社團、實習申請。<br />先找到自己的需要，再學會把工作交代清楚。</p></div>
        <div class="example-grid">{examples.map(item => (<article class="example-card"><div class="example-top"><span class="number">{item.number}</span><span class="sample-tag">成果示意</span></div><h3>{item.title}</h3><dl><div><dt>輸入</dt><dd>{item.input}</dd></div><div><dt>練習</dt><dd>{item.process}</dd></div><div><dt>產出</dt><dd>{item.output}</dd></div></dl><div class="output-preview"><p>{item.label} <span aria-hidden="true">↗</span></p><ul>{item.lines.map(line=>(<li>{line}</li>))}</ul></div></article>))}</div>
        <p class="section-note">以上為依課程內容製作的成果示意，並非學員作品或實際帳號畫面。</p>
      </section>

      <section class="change-section" aria-labelledby="change-title"><div class="page-width">
        <p class="eyebrow">02 ／ 學會一種做事的方法</p><h2 id="change-title">從會問問題，<br />走到能交付一件工作。</h2>
        <div class="change-list">{changes.map(item=>(<div class="change-row"><p class="change-before">{item.before}</p><span class="change-arrow" aria-hidden="true">→</span><div><p class="change-after">{item.after}</p><p class="change-skill">{item.skill}</p></div></div>))}</div>
        <p class="change-note">AI 協助整理與執行；判斷、查核與最後的選擇，仍需要我們參與。</p>
      </div></section>

      <section id="curriculum" class="course-section page-width" aria-labelledby="curriculum-title">
        <div class="section-heading"><div><p class="eyebrow">03 ／ 一週一個概念</p><h2 id="curriculum-title">8 週，走過三個階段。</h2></div><p>從第一份任務 SOP，<br />走到能持續使用的期末專題。</p></div>
        <div class="stage-grid">{stages.map(stage=>(<article class="stage"><p class="stage-index">{stage.number}<span>{stage.weeks}</span></p><h3>{stage.title}</h3><p class="stage-description">{stage.description}</p><div class="week-list">{stage.items.map(item=>(<details class="week-item"><summary><span>W{item.week}</span><span>{item.title}</span><span class="expand-mark" aria-hidden="true">+</span></summary><div class="week-content"><p>{item.concept}</p><p><strong>本週產出</strong><br />{item.outcome}</p></div></details>))}</div></article>))}</div>
        <div class="project-note"><p class="eyebrow">最後，帶走自己的作品</p><p>選課檢查、實習職缺追蹤、論文筆記、社團活動核銷……<br />期末專題是一支能解決自己真實問題，並練習持續使用至少 2 週的 Agent。</p></div>
      </section>

      <section id="overview" class="overview-section" aria-labelledby="overview-title"><div class="page-width overview-grid">
        <div><p class="eyebrow">04 ／ 有人一起，慢慢練習</p><h2 id="overview-title">不用先成為專家，<br />帶著自己的問題就好。</h2><p>課程面向成功大學學生，不限科系、不需程式背景。每週上課 1 小時，課後約 1–2 小時實作。</p><h3>三個學習成果</h3><ol class="learning-outcomes"><li>判斷適合交給 AI 的工作，拆出明確步驟。</li><li>使用工具串接（Connector）、任務手冊（Skill）與排程，建立可重複使用的 Agent。</li><li>理解 Agent 原理與五種工作流，選擇適合任務的做法。</li></ol></div>
        <div class="session-plan"><p class="eyebrow">每次課堂的基本節奏</p><h3>先做，再一起拆解。</h3><ol><li><span>10 分</span><div><strong>開場示範</strong><p>先看見本週要完成的成果</p></div></li><li><span>25 分</span><div><strong>跟著做</strong><p>一起完成最小可用版本</p></div></li><li><span>15 分</span><div><strong>拆解原理</strong><p>理解剛剛的做法為什麼有效</p></div></li><li><span>10 分</span><div><strong>分享與作業</strong><p>回看實作，再帶回生活裡練習</p></div></li></ol><p class="section-note">各週依實作主題調整，實際安排見講義。</p></div>
      </div></section>

      <section id="preparation" class="course-section page-width preparation-grid" aria-labelledby="preparation-title">
        <div><p class="eyebrow">開始之前</p><h2 id="preparation-title">準備一件你<br />真的想解決的事。</h2></div>
        <ul class="preparation-list"><li><strong>自己的帳號與工具</strong><p>示範以 Claude 為主，ChatGPT 使用者可參考課綱的功能對照。功能與方案限制以各工具最新官方說明為準。</p></li><li><strong>桌面 App 與個人 Google 帳號</strong><p>確認能開啟本機檔案，並使用個人帳號練習串接信箱與行事曆。</p></li><li><strong>一份真實的練習素材</strong><p>課表、待回信件或待閱讀文件都可以。挑一件願意反覆改善的小任務。</p></li></ul>
      </section>

      <section id="faq" class="course-section page-width faq-grid" aria-labelledby="faq-title"><div><p class="eyebrow">05 ／ 參與之前想知道</p><h2 id="faq-title">先把疑問，<br />放到桌上。</h2></div><div class="faq-list">{faqs.map(item=>(<details class="faq-item"><summary>{item.question}<span class="expand-mark" aria-hidden="true">+</span></summary><p>{item.answer}</p></details>))}</div></section>

      <section class="join-section" aria-labelledby="join-title"><div class="page-width join-grid"><div><p class="eyebrow">和願意動手的人，一起學</p><h2 id="join-title">第一件任務，<br />可以從這裡開始。</h2><p>活動日期、時間、地點、名額與報名方式，請依 LINE 社群公告確認。加入社群不等於完成活動報名。</p></div><a class="button button-light" href="/#join">查看 LINE 社群加入方式 <span aria-hidden="true">↗</span></a></div>
      </section>

      <section id="downloads" class="course-section resource-section page-width" aria-labelledby="downloads-title">
        <div class="section-heading"><div><p class="eyebrow">06 ／ 回來繼續練習</p><h2 id="downloads-title">課綱與講義下載</h2></div><span class="availability">已上架至第 6 週</span></div>
        <p>目前提供完整 8 週課綱與第 1–6 週講義。第 7–8 週講義將依課程進度陸續更新。</p>
        <p>點選下方項目即可開啟 PDF。在 LINE 內開啟後，可使用瀏覽器的分享或下載功能保存檔案。</p>
        <div class="resource-list">
          {resources.map((resource, index) => (
            <article class="resource-card">
              <p class="number">{String(index + 1).padStart(2, '0')}</p>
              <div class="resource-copy">
                <h3>{resource.title}</h3>
                <p>{resource.detail}</p>
                <p class="meta">{resource.meta}</p>
              </div>
              <a class="resource-link" href={resource.href} target="_blank" rel="noopener" aria-label={`開啟 ${resource.title} PDF`}>開啟 PDF <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
        <p class="upcoming">第 7–8 週 · 準備中，將依課程進度更新。</p>
        <p class="version-note">本頁更新：<time datetime="2026-11-01">2026-11-01</time> · 課綱與第 1–6 週講義已上架。</p>
      </section>
    </main>

    <footer>
      <span>成大橫渠閱人社</span>
      <span>X-Bridge Yueren Club · 發起於成功大學 · 社團申請籌備中</span>
    </footer>
  </body>
</html>

<style>
  :root { color: #243746; background: #f3efe6; font-family: "Noto Sans TC", system-ui, sans-serif; font-synthesis: none; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 24px; }
  body { margin: 0; line-height: 1.8; font-size: 17px; }
  a { color: inherit; text-decoration: none; }
  a:focus-visible, summary:focus-visible { outline: 3px solid #8a4834; outline-offset: 5px; }
  a:hover { color: #8a4834; }
  p, h1, h2, h3 { margin-top: 0; }
  h1, h2, h3, .book-title { font-family: "Noto Serif TC", "Songti TC", "PMingLiU", serif; }
  h2 { font-size: clamp(30px, 3.3vw, 40px); font-weight: 500; line-height: 1.45; margin: 16px 0 24px; }
  h3 { font-size: 23px; line-height: 1.5; font-weight: 600; }
  .page-width { max-width: 1280px; padding-left: 48px; padding-right: 48px; margin: 0 auto; }
