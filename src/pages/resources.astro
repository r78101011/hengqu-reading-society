---
const curriculum = [
  { week: '01', title: 'AI 實習生報到', concept: '任務判斷、SOP 拆解、Context 與 Memory', outcome: '寫出一份自己的任務 SOP' },
  { week: '02', title: '接上你的生活', concept: 'MCP 與 Connector：連接信箱、行事曆等工具', outcome: '產出每日待辦與待回信件摘要' },
  { week: '03', title: '寫一本 AI 手冊', concept: 'Agent Skill、排程、權限與 Prompt Injection', outcome: '建立可重複使用的 Skill，練習自動執行' },
  { week: '04', title: '拆開 Agent 看原理', concept: '聊天機器人與 Agent 的差別、LLM 特性與五種工作流', outcome: '為自己的任務選擇一種工作流' },
  { week: '05', title: '工作流實作（一）', concept: 'Prompt Chaining、Routing、Parallelization', outcome: '從三種工作流中選一種完成實作' },
  { week: '06', title: '工作流實作（二）', concept: 'Evaluator-Optimizer、Orchestrator-Workers', outcome: '練習檢核會議紀錄或製作附出處的研究報告' },
  { week: '07', title: '從一支到一隊', concept: '多個 Skill 分工、團隊公約與時間／額度成本', outcome: '完成期末專題初版，記錄使用成本' },
  { week: '08', title: '成果發表', concept: '展示、互評、分享與反思', outcome: '發表能解決自己真實問題的 Agent' },
];

const resources = [
  {
    title: 'AI Agent 訓練營｜8 週課綱',
    detail: '2026-10-20 版本',
    meta: 'PDF · 4 頁 · 373 KB',
    href: '/downloads/ai-agent-camp-syllabus-20261020.pdf',
  },
  {
    title: 'AI Agent 訓練營｜第 1–2 週講義',
    detail: '第一、二週課程資料',
    meta: 'PDF · 22 頁 · 4.1 MB',
    href: '/downloads/ai-agent-camp-weeks-1-2.pdf',
  },
];

const siteUrl = 'https://xbridge.maxosoft.com';
const canonicalUrl = `${siteUrl}/resources/`;
const pageTitle = 'AI Agent 訓練營｜8 週課程介紹與講義｜成大橫渠閱人社';
const pageDescription = '橫渠閱人社 AI Agent 訓練營，面向成功大學學生，不限科系、不需程式背景。每週 1 小時，透過 8 週實作學習 SOP、Connector、Skill 與工作流；查看課程大綱及下載講義。';
const socialImageUrl = `${siteUrl}/social-card.png?v=20261004`;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content="成大橫渠閱人社" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="成大橫渠閱人社：閱人，亦閱己。學生社團申請籌備中。" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="成大橫渠閱人社：閱人，亦閱己。學生社團申請籌備中。" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="X-Bridge Yueren Club 成大橫渠閱人社首頁">
        <img class="brand-mark" src="/brand/logo-primary.png" alt="" width="280" height="268" />
        <span class="brand-copy">
          <span>成大橫渠閱人社</span>
          <small>X-Bridge Yueren Club</small>
        </span>
      </a>
      <a class="home-link" href="/">回到首頁</a>
    </header>

    <main>
      <section class="intro" aria-labelledby="resources-title">
        <p class="eyebrow">AI AGENT CAMP · 8 週實作課程</p>
        <h1 id="resources-title"><span>AI Agent</span> <span>訓練營</span></h1>
        <p class="lead">跳脫對話框，讓 AI 替你做事。從自己的真實任務出發，用 8 週練習做出一支能持續幫自己工作的 AI Agent。</p>
        <p class="course-meta">主辦：橫渠閱人社 · 發起於成功大學 · 學生社團申請籌備中</p>
        <nav class="course-nav" aria-label="課程頁導覽"><a href="#overview">課程介紹</a><a href="#curriculum">8 週大綱</a><a href="#preparation">課前準備</a><a href="#downloads">下載講義</a></nav>
      </section>

      <section id="overview" class="course-section" aria-labelledby="overview-title">
        <p class="eyebrow">用自己的任務學習</p>
        <h2 id="overview-title">誰適合參加？會學到什麼？</h2>
        <p>課程對象為成功大學學生，不限科系、不需程式背景。以選課、報告、社團、實習申請與論文閱讀等校園情境練習，每週上課 1 小時，課後約 1–2 小時實作。</p>
        <h3>三個學習成果</h3>
        <ol class="learning-outcomes">
          <li>判斷哪些工作適合交給 AI，並拆成 AI 看得懂的步驟。</li>
          <li>使用 Connector、Skill 與排程，建立穩定、可重複使用的 Agent。</li>
          <li>理解 Agent 原理與五種工作流，面對新工具時知道如何選擇。</li>
        </ol>
        <p>課堂先示範、再跟著做，最後拆解原理。每次 60 分鐘分為開場示範 10 分鐘、跟著做 25 分鐘、拆解原理 15 分鐘，以及作業說明與分享 10 分鐘。</p>
        <div class="course-notice"><h3>參與與報名資訊</h3><p>本頁整理已公開課綱與講義；實際上課日期、時間、地點、名額與報名方式，請依 LINE 社群活動公告確認。加入社群不等於完成活動報名。</p><a class="text-link" href="/#join">查看 LINE 社群加入方式</a></div>
      </section>

      <section id="curriculum" class="course-section" aria-labelledby="curriculum-title">
        <p class="eyebrow">一週一個概念</p>
        <h2 id="curriculum-title">8 週課程大綱</h2>
        <p>前 3 週做出第一支 Agent，第 4 週拆解原理，第 5–6 週練習工作流，最後 2 週完成專題與分享。</p>
        <ol class="curriculum-list">{curriculum.map((item) => (<li><p class="number">第 {item.week} 週</p><div><h3>{item.title}</h3><p>{item.concept}</p><p class="outcome">本週產出：{item.outcome}</p></div></li>))}</ol>
        <p>期末專題以解決自己的真實問題為目標，例如選課檢查、實習職缺追蹤、論文筆記整理或社團活動核銷，並練習持續使用至少 2 週。</p>
      </section>

      <section id="preparation" class="course-section" aria-labelledby="preparation-title">
        <p class="eyebrow">開始之前</p>
        <h2 id="preparation-title">課前準備</h2>
        <ul class="preparation-list">
          <li>準備自己的 AI 帳號與適合實作的方案；示範以 Claude 為主，ChatGPT 使用者可參考 PDF 內的功能對照。功能與方案限制以各工具最新說明為準。</li>
          <li>安裝準備使用的 AI 桌面 App，並確認能開啟本機練習檔案。</li>
          <li>準備個人 Google 帳號，供信箱與行事曆串接練習使用。</li>
          <li>帶一份自己的課表、待回信件或待閱讀文件，從實際需求開始。</li>
        </ul>
      </section>

      <section id="downloads" class="resource-section" aria-labelledby="downloads-title">
        <p class="eyebrow">COURSE RESOURCES</p>
        <h2 id="downloads-title">課綱與講義下載</h2>
        <p>目前提供完整 8 週課綱與第 1–2 週講義。第 3–8 週講義將依課程進度陸續更新。</p>
        <p>點選下方項目即可開啟 PDF。在 LINE 內開啟後，可使用瀏覽器的分享或下載功能保存檔案。</p>
        <div class="resource-list">
          {resources.map((resource, index) => (
            <article class="resource-card">
              <p class="number">{String(index + 1).padStart(2, '0')}</p>
              <div class="resource-copy">
                <h2>{resource.title}</h2>
                <p>{resource.detail}</p>
                <p class="meta">{resource.meta}</p>
              </div>
              <a class="button" href={resource.href} target="_blank" rel="noopener" aria-label={`開啟 ${resource.title} PDF`}>開啟 PDF <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
        <p class="version-note">課綱依據：2026-10-20 版本 · 本頁更新：<time datetime="2026-10-31">2026-10-31</time></p>
      </section>
    </main>

    <footer>
      <span>成大橫渠閱人社</span>
      <span>X-Bridge Yueren Club · 發起於成功大學 · 社團申請籌備中</span>
    </footer>
  </body>
</html>

<style>
  :root {
    color: #243746;
    background: #f3efe6;
    font-family: "Noto Serif TC", "Songti TC", "PMingLiU", serif;
    font-synthesis: none;
  }

  * { box-sizing: border-box; }
  body { margin: 0; min-height: 100vh; line-height: 1.75; }
  a { color: inherit; text-decoration: none; }
  a:focus-visible { outline: 3px solid #a65d45; outline-offset: 4px; }

  .site-header {
    align-items: center;
    display: flex;
    justify-content: space-between;
    margin: 0 auto;
    max-width: 1280px;
    padding: 26px 48px;
  }
  .brand { align-items: center; display: inline-flex; font-size: 1.1rem; font-weight: 700; gap: 10px; line-height: 1.35; }
  .brand-mark { flex: 0 0 auto; height: 40px; width: auto; }
  .brand-copy { display: flex; flex-direction: column; }
  .brand small { color: #52685a; font-family: system-ui, sans-serif; font-size: .65rem; font-weight: 600; margin-top: 3px; }
  .home-link { font-family: system-ui, sans-serif; font-size: .9rem; min-height: 44px; padding: 8px 6px; }
  .home-link:hover { color: #8a4834; }

  .intro, .resource-section, .course-section { margin: 0 auto; max-width: 1184px; padding-left: 48px; padding-right: 48px; }
  html { scroll-behavior: smooth; }
  .course-section { border-bottom: 1px solid #d8d5cc; padding-top: 56px; padding-bottom: 56px; }
  .course-section > p, .course-section > ul, .learning-outcomes { max-width: 800px; }
  h2 { font-size: clamp(1.7rem, 4vw, 2.4rem); font-weight: 500; line-height: 1.4; margin: 16px 0 24px; }
  h3 { font-size: 1.2rem; line-height: 1.5; margin: 26px 0 12px; }
  .course-meta, .version-note { color: #475b4e; font-family: system-ui, sans-serif; font-size: .85rem; margin-top: 24px; }
  .course-nav { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 24px; font-family: system-ui, sans-serif; }
  .course-nav a, .text-link { display: inline-block; padding: 8px 0; text-decoration: underline; text-underline-offset: 5px; }
  .learning-outcomes li, .preparation-list li { margin-bottom: 12px; }
  .course-notice { background: #e8e5dc; margin-top: 32px; padding: 24px; }
  .course-notice h3 { margin-top: 0; }
  .course-notice p { max-width: 800px; }
  .curriculum-list { list-style: none; padding: 0; margin: 32px 0; }
  .curriculum-list li { border-top: 1px solid #c9c8c0; display: grid; gap: 24px; grid-template-columns: 100px minmax(0, 1fr); padding: 24px 0; }
  .curriculum-list h3 { margin-top: 0; }
  .curriculum-list p { margin-bottom: 8px; }
  .curriculum-list .outcome { color: #475b4e; }
  .intro { border-bottom: 1px solid #d8d5cc; padding-bottom: 64px; padding-top: 72px; }
  .eyebrow, .number { color: #8a4834; font-family: system-ui, sans-serif; font-size: .8rem; font-weight: 700; letter-spacing: .12em; }
  .eyebrow { margin: 0; }
  h1 { font-size: clamp(3rem, 7vw, 5.7rem); font-weight: 500; letter-spacing: -.03em; line-height: 1.12; margin: 24px 0; }
  h1 span { display: inline-block; }
  .lead { color: #475b4e; font-size: 1.12rem; margin: 0; max-width: 690px; }

  .resource-section { padding-bottom: 96px; padding-top: 32px; }
  .resource-list { border-top: 1px solid #c9c8c0; }
  .resource-card {
    align-items: center;
    border-bottom: 1px solid #c9c8c0;
    display: grid;
    gap: 28px;
    grid-template-columns: 48px minmax(0, 1fr) auto;
    padding: 34px 0;
  }
  .number { margin: 0; }
  .resource-copy h2 { font-size: 1.45rem; font-weight: 600; line-height: 1.4; margin: 0 0 7px; }
  .resource-copy p { color: #475b4e; margin: 0; }
  .resource-copy .meta { font-family: system-ui, sans-serif; font-size: .82rem; margin-top: 5px; }
  .button {
    align-items: center;
    background: #243746;
    color: #fff;
    display: inline-flex;
    font-family: system-ui, sans-serif;
    font-size: .93rem;
    gap: 8px;
    justify-content: center;
    min-height: 48px;
    padding: 11px 20px;
  }
  .button:hover { background: #8a4834; }

  footer {
    background: #243746;
    color: #d8d5cc;
    display: flex;
    font-family: system-ui, sans-serif;
    font-size: .75rem;
    justify-content: space-between;
    padding: 25px max(48px, calc((100vw - 1184px) / 2));
  }

  @media (max-width: 720px) {
    .site-header { padding: 20px 24px; }
    .brand { font-size: 1rem; }
    .brand-mark { height: 36px; }
    .brand small { font-size: .58rem; }
    .home-link { font-size: .83rem; }
    .intro, .resource-section, .course-section { padding-left: 24px; padding-right: 24px; }
    .course-section { padding-top: 36px; padding-bottom: 36px; }
    .curriculum-list li { grid-template-columns: 1fr; gap: 8px; }
    .course-notice { padding: 20px; }
    .intro { padding-bottom: 48px; padding-top: 42px; }
    h1 { font-size: clamp(2.7rem, 15vw, 4rem); }
    .lead { font-size: 1.02rem; }
    .resource-section { padding-bottom: 64px; padding-top: 20px; }
    .resource-card { align-items: start; gap: 10px 16px; grid-template-columns: 34px minmax(0, 1fr); padding: 28px 0; }
    .resource-copy h2 { font-size: 1.25rem; }
    .button { grid-column: 2; margin-top: 8px; width: 100%; }
    footer { flex-wrap: wrap; gap: 12px; padding: 22px 24px; }
  }
</style>
